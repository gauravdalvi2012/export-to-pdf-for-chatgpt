{
  "name": "chatgpt-pdf-extension",
  "version": "1.0.0",
  "description": "Chrome Manifest V3 extension to export ChatGPT conversations as PDFs.",
  "type": "module",
  "scripts": {
    "build": "esbuild src/index.js --bundle --format=iife --outfile=export.js",
    "watch": "esbuild src/index.js --bundle --format=iife --outfile=export.js --watch",
    "package": "node scripts/package.js"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
