{
  "name": "export-to-pdf-for-chatgpt",
  "version": "1.0.0",
  "description": "Chrome extension to export ChatGPT conversations as clean, formatted PDFs.",
  "type": "module",
  "author": "Gaurav Dalvi",
  "license": "MIT",
  "homepage": "https://chromewebstore.google.com/detail/export-to-pdf-for-chatgpt/pfkbinehddbjfacdgcghoflahnllcpaf",
  "repository": {
    "type": "git",
    "url": "https://github.com/gauravdalvi2012/export-to-pdf-for-chatgpt.git"
  },
  "scripts": {
    "build": "esbuild src/index.ts --bundle --format=iife --outfile=export.js",
    "watch": "esbuild src/index.ts --bundle --format=iife --outfile=export.js --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "package": "node scripts/package.js"
  },
  "devDependencies": {
    "@types/chrome": "0.3.7",
    "esbuild": "0.28.2",
    "happy-dom": "21.0.4",
    "prettier": "3.10.1",
    "typescript": "7.0.2",
    "vitest": "5.1.1"
  }
}
